/*
 * Aquila AM69 Clover MAX96724 connected to MAX96717 - GMSL Link 0 (SIOA)
 *
 */

/dts-v1/;
/plugin/;

#include "k3-am69-aquila-clover-csi2-gmsl-deserializer.dtso"

/ {
	compatible = "toradex,aquila-am69";
};

&max96724 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			gmsl_des0_in: endpoint {
				remote-endpoint = <&gmsl_ser0_out>;
			};
		};
	};

	i2c-mux {
		#address-cells = <1>;
		#size-cells = <0>;

		i2c@0 {
			reg  = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			gmsl_ser0: gmsl-serializer@42 {
				compatible = "maxim,max96717";
				reg = <0x42>;
				#gpio-cells = <2>;
				gpio-controller;
				gpio-ranges = <&gmsl_ser0 0 0 11>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@1 {
						reg = <1>;

						gmsl_ser0_out: endpoint {
							remote-endpoint = <&gmsl_des0_in>;
						};
					};
				};
			};
		};
	};
};
